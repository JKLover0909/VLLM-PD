# Tailscale IP of Machine 1 (Windows LLM Host)
TAILSCALE_M1_IP=100.100.1.1  # Hãy thay thế bằng IP Tailscale thực tế của Máy 1

# Cloud API Keys
OPENAI_API_KEY=your_openai_api_key_here
MIMO_API_KEY=your_mimo_api_key_here

# Services configurations on Machine 2
LITELLM_PROXY_PORT=4000
QDRANT_HOST=localhost
QDRANT_PORT=6333

# App Directories
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
