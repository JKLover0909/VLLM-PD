# Example environment for cctvai-host-metrics-api.service.
# Copy to /etc/cctvai-host-metrics/api.env (root:cctvai-metrics-api, mode
# 0640) and adjust. Do NOT commit the real file, the real token, or the
# real TLS key anywhere -- this is an example with placeholder paths only.

# Bearer token file. Generate the token separately (e.g.
# `openssl rand -hex 32 > /etc/cctvai-host-metrics/token`), then:
#   chown root:cctvai-metrics-api /etc/cctvai-host-metrics/token
#   chmod 0640 /etc/cctvai-host-metrics/token
# Startup fails closed if this variable or the file it points to is
# missing/empty -- there is no default token.
HOST_METRICS_TOKEN_FILE=/etc/cctvai-host-metrics/token

# Must match the collector's HOST_METRICS_SNAPSHOT_PATH.
HOST_METRICS_SNAPSHOT_PATH=/run/cctvai-metrics/snapshot.json

# Reject a snapshot older than this many seconds (freshness limit).
HOST_METRICS_MAX_AGE_SECONDS=30

# TLS: a private CA-signed (or otherwise pinned) cert/key pair with the
# correct SAN (server hostname/IP that Meibook Dev will connect to).
# Startup fails closed if either path is missing or unreadable.
HOST_METRICS_TLS_CERTFILE=/etc/cctvai-host-metrics/tls/server.crt
HOST_METRICS_TLS_KEYFILE=/etc/cctvai-host-metrics/tls/server.key

# Bind address/port. 8099 is the plan's proposed port -- verify it is free
# on the target host before enabling the service.
HOST_METRICS_BIND_HOST=0.0.0.0
HOST_METRICS_BIND_PORT=8099
