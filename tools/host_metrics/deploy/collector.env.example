# Example environment for cctvai-host-metrics-collector.service.
# Copy to /etc/cctvai-host-metrics/collector.env (root:cctvai-metrics-collector,
# mode 0640) and adjust. Contains no secrets -- do not add any here; the
# collector does not authenticate anything.

# Where the collector writes the atomic snapshot file. Must match
# HOST_METRICS_SNAPSHOT_PATH in api.env and match the systemd
# RuntimeDirectory in cctvai-host-metrics-collector.service.
HOST_METRICS_SNAPSHOT_PATH=/run/cctvai-metrics/snapshot.json

# Seconds between samples. Keep this in sync with the shared default in
# tools/host_metrics/schemas.py (DEFAULT_SAMPLE_INTERVAL_SECONDS) unless
# you have a specific reason to deviate.
HOST_METRICS_SAMPLE_INTERVAL_SECONDS=10

# Override only if these binaries are not on PATH inside the venv/unit
# environment. Left at their defaults on a standard Ubuntu + NVIDIA driver
# + Docker install.
# HOST_METRICS_DOCKER_BIN=docker
# HOST_METRICS_NVIDIA_SMI_BIN=nvidia-smi

HOST_METRICS_LOG_LEVEL=INFO
