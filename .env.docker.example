# ============================================================
# Meibook Docker web-only deployment
# Copy to `.env.docker`, then fill API keys and host-specific values.
# This mode exposes only the web/API service on port 8001.
# Ngrok and Coding Agent are disabled.
# ============================================================

QWEN_CHAT_API_BASE=http://192.168.10.124:11434
QWEN_CHAT_NGROK_API_BASE=https://your-qwen-chat-tunnel.example
QWEN_SMALL_API_BASE=http://host.docker.internal:11435
# OpenAI-compatible Ollama LAN primary and llama.cpp/ngrok Q5 fallback.
QWEN_CODER_LAN_API_BASE=http://192.168.10.14:11434/v1
QWEN_CODER_LAN_API_KEY=sk-local
QWEN_CODER_NGROK_API_BASE=https://your-qwen-coder-tunnel.example/v1
QWEN_CODER_NGROK_API_KEY=sk-local

# LiteLLM role-specific cloud fallbacks. The current Azure gateway is
# OpenAI-compatible, so the three Azure aliases initially use its verified
# Grok model. Set distinct Azure deployments later in litellm_config.yaml if
# they become available; never put credentials in that file.
OPENAI_API_KEY=your_openai_api_key_here

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-05-01-preview
# Informational only, not read by app code. Azure role fallbacks
# (azure-chat/small/coder-fallback in litellm_config.yaml) use gpt-5.4-mini as
# of 2026-09-04; the legacy vision route (grok-model) still uses
# grok-4-20-reasoning on the same resource.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Application retry for an empty primary Chat response. LiteLLM itself uses
# the role-specific chain local -> Azure -> OpenAI.
CHAT_FALLBACK_MODEL=azure-chat-fallback

LITELLM_URL=http://litellm:4000/v1
LITELLM_PROXY_PORT=4000
LITELLM_MASTER_KEY=sk-local
LITELLM_LOCAL_MODEL_COST_MAP=True
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=local-qwen-small

MACHINE2_API_HOST=0.0.0.0
MACHINE2_API_PORT=8001
MACHINE2_API_LOCAL_URL=http://localhost:8001

QDRANT_HOST=qdrant
QDRANT_PORT=6333

MKAC_COLLECTION_NAME=mkac_knowledge
MKAC_SOURCE_DIR=/app/documents/MKAC
MKAC_MANIFEST_PATH=/app/config/mkac_manifest.json
MKAC_PAGE_IMAGE_DIR=/app/mkac_processed/pages
MKAC_INDEX_REPORT=/app/logs/mkac_index_report.json
MKAC_SCORE_THRESHOLD=0.48
MKAC_WEB_SEARCH_ENABLED=true
MKAC_WEB_SEARCH_CONTEXT="Công ty Cổ phần Meiko Automation MKAC"
MKAC_WEB_SEARCH_REGION=vn-vi
MKAC_WEB_SEARCH_MAX_RESULTS=5
MKAC_WEB_SEARCH_TIMEOUT=10

RESEARCH_DEMO_DIR=/app/documents/Research
RESEARCH_DEMO_SESSION_ID=00000000-0000-4000-8000-000000000001
RESEARCH_DEMO_INDEX_REPORT=/app/logs/research_demo_index_report.json
DOCJP_COLLECTION_NAME=docjp_knowledge
DOCJP_SESSION_ID=docjp
RESEARCH_TOPICS_PATH=/app/config/research_topics.json
RESEARCH_TOP_K=6
RESEARCH_MAX_TOKENS=768
RESEARCH_SCORE_THRESHOLD=0.35

EMPLOYEE_DIRECTORY_SOURCE_DIR=/app/documents/MKAC
EMPLOYEE_DIRECTORY_SOURCE_GLOB="3. DANH SÁCH KHÁM SỨC KHOẺ 2026.pdf"
EMPLOYEE_DIRECTORY_DB_PATH=/app/data/employee_directory.sqlite
EMPLOYEE_DIRECTORY_SUMMARY_PATH="/app/documents/MKAC/0. Thong tin nhan su va lanh dao MKAC.html"

# MES production data integration. Install MES_CA_CERT for production TLS.
MES_API_URL=https://192.86.0.225:3800/api/dynamics
MES_API_TOKEN=your_mes_bearer_token_here
MES_API_SCHEMA_DATA=MES_DATA
MES_API_TIMEOUT=15
MES_VERIFY_TLS=true
MES_CA_CERT=
MES_DATABASE_ENABLED=true
MES_DATABASE_PATH=/app/data/mes.sqlite
# WMS contract v4 / Phase 2C: separate current-balance, legacy-archive and raw
# audit domains. Enable only after validating the Dev snapshot; never copy this
# runtime file to Production.
MES_WMS_DATABASE_ENABLED=false
MES_WMS_DATABASE_PATH=/app/data/mes_wms.sqlite
# CCTVAI replica (PostgreSQL read-only). Enable on Dev after confirming replica connectivity.
# CCTVAI_DB_HOST and CCTVAI_DB_PASSWORD are secret — put them only in .env.docker (untracked).
# Never commit real values to this file or any tracked file.
CCTVAI_DATABASE_ENABLED=false
CCTVAI_DB_HOST=
CCTVAI_DB_PORT=55434
CCTVAI_DB_NAME=cctvai
CCTVAI_DB_USER=cctvai_llm_ro
CCTVAI_DB_PASSWORD=
CCTVAI_DB_CONNECT_TIMEOUT=3
CCTVAI_DB_STATEMENT_TIMEOUT_MS=5000
CCTVAI_HEALTH_TTL_SECONDS=30
CCTVAI_HEALTH_BREAKER_THRESHOLD=3
CCTVAI_HEALTH_BREAKER_COOLDOWN_SECONDS=60
CCTVAI_MAX_ROWS=50
# LLM SQL fallback — only reached when none of the 7 deterministic intents
# match (cctvai_scope_clarification). Mirrors WMS/MES's already-live SQL
# agent pattern below; keep disabled in Production until validated there.
CCTVAI_SQL_AGENT_ENABLED=false
CCTVAI_SEMANTIC_MODEL_PATH=/app/config/cctvai_semantic_model.json
CCTVAI_SQL_AGENT_MAX_ROWS=50
CCTVAI_SQL_AGENT_MAX_ATTEMPTS=2
CCTVAI_SQL_AGENT_MODEL=local-qwen-coder
CCTVAI_SQL_PLANNER_MAX_TOKENS=1200
CCTVAI_SQL_ANSWER_MAX_TOKENS=384
# CCTVAI host hardware metrics (read-only HTTPS service on the CCTVAI server).
# Independent of the PostgreSQL replica above: hardware questions must still be
# answerable when the replica is down, and vice versa.
# CCTVAI_HARDWARE_ENDPOINT and the token file are secret — real values belong
# only in .env.docker (untracked) and in a mounted file, never in this template.
CCTVAI_HARDWARE_ENABLED=false
CCTVAI_HARDWARE_URL=
# Bearer token read from a file, not from an env var, so it does not appear in
# `docker inspect` or process listings.
CCTVAI_HARDWARE_TOKEN_PATH=/app/data/cctvai_hardware_token
# Private CA that signed the metrics service certificate. Never set verify=False.
CCTVAI_HARDWARE_CA_PATH=/app/data/cctvai_hardware_ca.pem
CCTVAI_HARDWARE_TIMEOUT_SECONDS=5
CCTVAI_HARDWARE_CACHE_SECONDS=5
# Snapshots older than this are rejected instead of being reported as current.
CCTVAI_HARDWARE_MAX_AGE_SECONDS=30
# A snapshot timestamped this far in the future means a clock/config problem,
# not fresh data, so it is rejected too.
CCTVAI_HARDWARE_MAX_FUTURE_SKEW_SECONDS=30
CCTVAI_HARDWARE_MAX_BYTES=262144
# Local-only summariser alias; deliberately absent from litellm_config.yaml
# `fallbacks:` so host metrics can never be sent to a cloud provider.
CCTVAI_HARDWARE_MODEL=local-hardware-summary
CCTVAI_HARDWARE_ANSWER_MAX_TOKENS=384
MES_SQL_AGENT_ENABLED=true
MES_SEMANTIC_MODEL_PATH=/app/config/mes_semantic_model.json
MES_SQL_AGENT_MAX_ROWS=100
MES_SQL_AGENT_TIMEOUT=2
MES_SQL_AGENT_MAX_ATTEMPTS=2

# Gmail send action. Put OAuth client JSON at ./data/gmail_credentials.json on host.
GMAIL_SEND_ENABLED=false
GMAIL_CREDENTIALS_PATH=/app/data/gmail_credentials.json
GMAIL_TOKEN_PATH=/app/data/gmail_token.json
GMAIL_ALLOW_INTERACTIVE_AUTH=false
GMAIL_SENDER_EMAIL=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=100
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300
UPLOAD_PROCESSING_CONCURRENCY=1
UPLOAD_QUEUE_SIZE=4
QUERY_RATE_LIMIT_PER_MINUTE=15
UPLOAD_RATE_LIMIT_PER_HOUR=10
MIN_QUERY_RESPONSE_SECONDS=2.0
# WMS pacing only spaces completed deterministic milestones for readable UI.
# Set 0 to disable it; this never changes validation or data results.
WMS_VERIFICATION_STEP_PACING_SECONDS=0.55
LOG_LEVEL=INFO

# Use CPU by default for portable Docker deployment.
# Change to cuda only on hosts with NVIDIA driver + nvidia-container-toolkit.
EMBEDDING_DEVICE=cpu
EMBEDDING_DTYPE=float32
EMBEDDING_BATCH_SIZE=4
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
DOCLING_OCR_LANGUAGES=vi,en
# Reserved for future Google Vision OCR integration. Not used by the current
# Docling OCR pipeline yet.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
MKAC_INDEX_EMBEDDING_DEVICE=cpu
# Standalone Research indexers default to CPU for the same VRAM reason.
RESEARCH_INDEX_EMBEDDING_DEVICE=cpu

# Web-only Docker deployment keeps Coding Agent disabled.
ENABLE_AGENT=false
AGENT_API_KEY=
WORKSPACE_DIR=/app
AGENT_REPOSITORY_DIR=/app
