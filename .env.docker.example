# ============================================================
# Meibook Docker web-only deployment
# Copy to `.env.docker`, then fill API keys and host-specific values.
# This mode exposes only the web/API service on port 8001.
# Ngrok and Coding Agent are disabled.
# ============================================================

OLLAMA_API_BASE=http://192.168.0.105:11434
OLLAMA_MODEL=gemma4:latest

OPENAI_API_KEY=your_openai_api_key_here

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=grok-4-20-reasoning

LITELLM_URL=http://litellm:4000/v1
LITELLM_PROXY_PORT=4000
LITELLM_MASTER_KEY=sk-local
LITELLM_LOCAL_MODEL_COST_MAP=True
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=openai-model

MACHINE2_API_HOST=0.0.0.0
MACHINE2_API_PORT=8001
MACHINE2_API_LOCAL_URL=http://localhost:8001

QDRANT_HOST=qdrant
QDRANT_PORT=6333

MKAC_COLLECTION_NAME=mkac_knowledge
MKAC_SOURCE_DIR=/app/documents/MKAC
MKAC_MANIFEST_PATH=/app/config/mkac_manifest.json
MKAC_PAGE_IMAGE_DIR=/app/mkac_processed/pages
MKAC_INDEX_REPORT=/app/logs/mkac_index_report.json
MKAC_SCORE_THRESHOLD=0.48
MKAC_WEB_SEARCH_ENABLED=true
MKAC_WEB_SEARCH_CONTEXT="Công ty Cổ phần Meiko Automation MKAC"
MKAC_WEB_SEARCH_REGION=vn-vi
MKAC_WEB_SEARCH_MAX_RESULTS=5
MKAC_WEB_SEARCH_TIMEOUT=10
EMPLOYEE_DIRECTORY_SOURCE_DIR=/app/documents/MKAC
EMPLOYEE_DIRECTORY_SOURCE_GLOB="3. DANH SÁCH KHÁM SỨC KHOẺ 2026.pdf"
EMPLOYEE_DIRECTORY_DB_PATH=/app/data/employee_directory.sqlite
EMPLOYEE_DIRECTORY_SUMMARY_PATH="/app/documents/MKAC/0. Thong tin nhan su va lanh dao MKAC.html"

# MES production data integration. Install MES_CA_CERT for production TLS.
MES_API_URL=https://192.86.0.225:3800/api/dynamics
MES_API_TOKEN=your_mes_bearer_token_here
MES_API_SCHEMA_DATA=MES_DATA
MES_API_TIMEOUT=15
MES_VERIFY_TLS=true
MES_CA_CERT=
MES_DATABASE_ENABLED=true
MES_DATABASE_PATH=/app/data/mes.sqlite
MES_SQL_AGENT_ENABLED=true
MES_SEMANTIC_MODEL_PATH=/app/config/mes_semantic_model.json
MES_SQL_AGENT_MAX_ROWS=100
MES_SQL_AGENT_TIMEOUT=2
MES_SQL_AGENT_MAX_ATTEMPTS=2

# Gmail send action. Put OAuth client JSON at ./data/gmail_credentials.json on host.
GMAIL_SEND_ENABLED=false
GMAIL_CREDENTIALS_PATH=/app/data/gmail_credentials.json
GMAIL_TOKEN_PATH=/app/data/gmail_token.json
GMAIL_ALLOW_INTERACTIVE_AUTH=false
GMAIL_SENDER_EMAIL=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=100
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300
UPLOAD_PROCESSING_CONCURRENCY=1
UPLOAD_QUEUE_SIZE=4
QUERY_RATE_LIMIT_PER_MINUTE=15
UPLOAD_RATE_LIMIT_PER_HOUR=10
LOG_LEVEL=INFO

# Use CPU by default for portable Docker deployment.
# Change to cuda only on hosts with NVIDIA driver + nvidia-container-toolkit.
EMBEDDING_DEVICE=cpu
EMBEDDING_DTYPE=float32
EMBEDDING_BATCH_SIZE=4
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
DOCLING_OCR_LANGUAGES=vi,en
# Reserved for future Google Vision OCR integration. Not used by the current
# Docling OCR pipeline yet.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
MKAC_INDEX_EMBEDDING_DEVICE=cpu
RESEARCH_DEMO_DIR=/app/documents/Research
RESEARCH_DEMO_SESSION_ID=00000000-0000-4000-8000-000000000001
RESEARCH_DEMO_INDEX_REPORT=/app/logs/research_demo_index_report.json
RESEARCH_INDEX_EMBEDDING_DEVICE=cpu

# Web-only Docker deployment keeps Coding Agent disabled.
ENABLE_AGENT=false
AGENT_API_KEY=
WORKSPACE_DIR=/app
AGENT_REPOSITORY_DIR=/app
