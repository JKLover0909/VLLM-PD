{
  "env": {
    "MEIBOOK_PYTHON": "/home/jkl/miniconda3/envs/meibook-dev/bin/python",
    "MEIBOOK_HOST_ENV": "meibook-dev",
    "PYTHONNOUSERSITE": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-meibook-python.sh\"",
            "timeout": 5,
            "statusMessage": "Checking Meibook Dev Python environment"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-environment.sh\"",
            "timeout": 5,
            "statusMessage": "Checking Dev/Production boundary"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
