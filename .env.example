# ============================================================
# Meibook local configuration template
# Copy this file to `.env`, then replace placeholder values.
# Do not commit `.env` because it may contain real API keys.
# ============================================================

# ------------------------------------------------------------
# Machine 1 / LLM host
# ------------------------------------------------------------
# Optional Tailscale IP or hostname of Machine 1.
# Current setup uses Machine 1's internal Ollama URL below instead.
TAILSCALE_M1_IP=your_machine_1_tailscale_ip_here

# Machine 1 currently exposes Ollama/Gemma4 on the LAN:
OLLAMA_API_BASE=http://192.168.0.105:11434
OLLAMA_MODEL=gemma4:latest

# Local model migration targets. Qwen chat is served by Ollama through
# LiteLLM's ollama_chat provider, so keep this as the Ollama root URL and do
# not append /v1. Qwen Coder is served by llama.cpp's OpenAI-compatible endpoint.
QWEN_CHAT_API_BASE=http://192.84.106.72:11434
QWEN_CHAT_NGROK_API_BASE=https://carless-overarch-establish.ngrok-free.dev
QWEN_CHAT_MODEL=qwen3:14b
# In docker-compose.web.yml this points to the local Ollama system service
# through the persistent ollama-proxy container. If running LiteLLM directly on
# the host, use http://localhost:11434 instead.
QWEN_SMALL_API_BASE=http://host.docker.internal:11435
QWEN_SMALL_MODEL=qwen2.5:3b-instruct
QWEN_CODER_API_BASE=https://d3d2-2405-4803-f16d-d2f0-b282-e2ff-fe05-dfe9.ngrok-free.app/v1
QWEN_CODER_MODEL=/home/jkl0909/models/qwen2.5-coder-14b/Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf
QWEN_CODER_API_KEY=sk-local
LOCAL_CHAT_NUM_CTX=16384
LOCAL_AUX_NUM_CTX=4096

# ------------------------------------------------------------
# Cloud fallback API keys
# ------------------------------------------------------------
# Used by litellm_config.yaml for fallback routes.
# Leave placeholders if you only want to test local Ollama models.
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI-compatible configuration used by the Grok web route and
# Notebooks/Test_API_Azure.ipynb. Keep /openai/v1 in this endpoint.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=grok-4-20-reasoning

# ------------------------------------------------------------
# LiteLLM proxy
# ------------------------------------------------------------
# Python code expects the OpenAI-compatible /v1 base URL.
# Docker compose exposes LiteLLM on localhost:4000.
LITELLM_URL=http://localhost:4000/v1
LITELLM_PROXY_PORT=4000
LITELLM_MASTER_KEY=sk-local
LITELLM_LOCAL_MODEL_COST_MAP=True

# UI translation layer. The backend core remains Vietnamese; Japanese UI
# requests are translated into Vietnamese before routing, then translated back.
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=local-qwen-small
TRANSLATION_TEMPERATURE=0.1

# ------------------------------------------------------------
# Machine 2 public API exposure
# ------------------------------------------------------------
# API Gateway runs locally on port 8001. The startup script reads the
# temporary public URL directly from ngrok and prints it in the terminal.
MACHINE2_API_HOST=0.0.0.0
MACHINE2_API_PORT=8001
MACHINE2_API_LOCAL_URL=http://localhost:8001
# Optional: only set this when your ngrok account has a reserved/static domain.
# Leave it empty on ngrok Free so scripts/run_ngrok.sh can create a random URL.
NGROK_RESERVED_DOMAIN=

# LiteLLM stays internal. Machine 3 uses the API Gateway above.
MACHINE2_LITELLM_LOCAL_URL=http://localhost:4000

# ------------------------------------------------------------
# Qdrant vector database
# ------------------------------------------------------------
# docker-compose.yml exposes Qdrant on localhost:6333.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Shared MKAC knowledge base
MKAC_COLLECTION_NAME=mkac_knowledge
MKAC_SOURCE_DIR=documents/MKAC
MKAC_MANIFEST_PATH=config/mkac_manifest.json
MKAC_PAGE_IMAGE_DIR=mkac_processed/pages
MKAC_INDEX_REPORT=logs/mkac_index_report.json
MKAC_SCORE_THRESHOLD=0.48
# Search the public web only when no internal MKAC chunk passes the threshold.
MKAC_WEB_SEARCH_ENABLED=true
MKAC_WEB_SEARCH_CONTEXT="Công ty Cổ phần Meiko Automation MKAC"
MKAC_WEB_SEARCH_REGION=vn-vi
MKAC_WEB_SEARCH_MAX_RESULTS=5
MKAC_WEB_SEARCH_TIMEOUT=10

# Research / DocJP knowledge base
RESEARCH_DEMO_DIR=documents/Research
RESEARCH_DEMO_SESSION_ID=00000000-0000-4000-8000-000000000001
RESEARCH_DEMO_INDEX_REPORT=logs/research_demo_index_report.json
DOCJP_COLLECTION_NAME=docjp_knowledge
DOCJP_SESSION_ID=docjp
RESEARCH_TOPICS_PATH=config/research_topics.json
RESEARCH_TOP_K=6
RESEARCH_MAX_TOKENS=768
RESEARCH_SCORE_THRESHOLD=0.35

# MKAC employee directory used by the simple employee-code gate.
EMPLOYEE_DIRECTORY_SOURCE_DIR=documents/MKAC
EMPLOYEE_DIRECTORY_SOURCE_GLOB="3. DANH SÁCH KHÁM SỨC KHOẺ 2026.pdf"
EMPLOYEE_DIRECTORY_DB_PATH=data/employee_directory.sqlite
EMPLOYEE_DIRECTORY_SUMMARY_PATH="documents/MKAC/0. Thong tin nhan su va lanh dao MKAC.html"

# MES production data integration. Install MES_CA_CERT for production TLS.
MES_API_URL=https://192.86.0.225:3800/api/dynamics
MES_API_TOKEN=your_mes_bearer_token_here
MES_API_SCHEMA_DATA=MES_DATA
MES_API_TIMEOUT=15
MES_VERIFY_TLS=true
MES_CA_CERT=

# Local read-only MES snapshot created by scripts/import_mes_database.py.
MES_DATABASE_ENABLED=true
MES_DATABASE_PATH=data/mes.sqlite
MES_SQL_AGENT_ENABLED=true
MES_SEMANTIC_MODEL_PATH=config/mes_semantic_model.json
MES_SQL_AGENT_MAX_ROWS=100
MES_SQL_AGENT_TIMEOUT=2
MES_SQL_AGENT_MAX_ATTEMPTS=2
# Keep Text-to-SQL on the coder model even when the user-facing chat route is
# still cloud during the gradual migration.
MES_SQL_AGENT_MODEL=local-qwen-coder

# Gmail send action. Store credentials/token under data/ because data/ is ignored
# by git and mounted into Docker. Use OAuth client JSON, not a Google API key.
GMAIL_SEND_ENABLED=false
GMAIL_CREDENTIALS_PATH=data/gmail_credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json
GMAIL_ALLOW_INTERACTIVE_AUTH=false
GMAIL_SENDER_EMAIL=

# ------------------------------------------------------------
# API Gateway / runtime paths
# ------------------------------------------------------------
# Used by src/api/main.py for uploaded documents and logging.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=100
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300
# Only one expensive parse/index job runs at a time; four more may wait.
UPLOAD_PROCESSING_CONCURRENCY=1
UPLOAD_QUEUE_SIZE=4
QUERY_RATE_LIMIT_PER_MINUTE=15
UPLOAD_RATE_LIMIT_PER_HOUR=10
QUERY_RESPONSE_CACHE_TTL_SECONDS=600
QUERY_RESPONSE_CACHE_SIZE=256
MIN_QUERY_RESPONSE_SECONDS=2.0
# Token budgets for local-model latency control. Keep SQL planner wider because
# it must return valid JSON/SQL; answer-formatting branches stay short.
MKAC_GENERAL_MAX_TOKENS=256
MKAC_SIMPLE_MAX_TOKENS=512
MKAC_EXTENDED_MAX_TOKENS=768
MES_GENERAL_MAX_TOKENS=256
MES_LIVE_API_MAX_TOKENS=192
MES_DATABASE_MAX_TOKENS=384
MES_SQL_PLANNER_MAX_TOKENS=1200
MES_SQL_ANSWER_MAX_TOKENS=384
LOG_LEVEL=INFO

# Keep BGE-M3 on Machine 2's GPU, but use half precision and small batches.
EMBEDDING_DEVICE=cuda
EMBEDDING_DTYPE=float16
EMBEDDING_BATCH_SIZE=8

# OCR/layout models use GPU for responsive research uploads. Keep upload
# concurrency and Docling batches at 1 to prevent concurrent VRAM spikes.
DOCLING_DEVICE=cuda
DOCLING_NUM_THREADS=4
DOCLING_OCR_LANGUAGES=vi,en
# Reserved for future Google Vision OCR integration. Not used by the current
# Docling OCR pipeline yet.
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# The standalone MKAC indexer defaults to CPU to avoid loading a second BGE-M3
# copy into VRAM while the API is running. Set cuda only when the API is stopped.
MKAC_INDEX_EMBEDDING_DEVICE=cpu

# Standalone Research indexers default to CPU for the same VRAM reason.
RESEARCH_INDEX_EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------
# Agent / MCP workspace
# ------------------------------------------------------------
# Required when calling POST /agent via the public API.
AGENT_API_KEY=replace_with_a_long_random_secret

# Directory that MCP filesystem/git tools are allowed to access.
WORKSPACE_DIR=/home/jkl0909/Code/llm
AGENT_REPOSITORY_DIR=/home/jkl0909/Code/llm/Meibook
