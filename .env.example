# ============================================================
# VLLM-PD local configuration template
# Copy this file to `.env`, then replace placeholder values.
# Do not commit `.env` because it may contain real API keys.
# ============================================================

# ------------------------------------------------------------
# Machine 1 / LLM host
# ------------------------------------------------------------
# Optional Tailscale IP or hostname of Machine 1.
# Current setup uses Machine 1's ngrok URL below instead.
TAILSCALE_M1_IP=your_machine_1_tailscale_ip_here

# Machine 1 currently exposes Ollama/Gemma4 through ngrok:
# https://carless-overarch-establish.ngrok-free.dev -> http://localhost:11434
OLLAMA_API_BASE=https://carless-overarch-establish.ngrok-free.dev
OLLAMA_MODEL=gemma4:latest

# ------------------------------------------------------------
# Cloud fallback API keys
# ------------------------------------------------------------
# Used by litellm_config.yaml for fallback routes.
# Leave placeholders if you only want to test local Ollama models.
OPENAI_API_KEY=your_openai_api_key_here
MIMO_API_KEY=your_mimo_api_key_here
# Use the base URL shown by your MiMo subscription. This example is
# the Singapore Token Plan cluster; pay-as-you-go uses api.xiaomimimo.com.
MIMO_API_BASE=https://token-plan-sgp.xiaomimimo.com/v1

# Azure OpenAI-compatible configuration used by the Grok web route and
# Notebooks/Test_API_Azure.ipynb. Keep /openai/v1 in this endpoint.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=grok-4-20-reasoning

# ------------------------------------------------------------
# LiteLLM proxy
# ------------------------------------------------------------
# Python code expects the OpenAI-compatible /v1 base URL.
# Docker compose exposes LiteLLM on localhost:4000.
LITELLM_URL=http://localhost:4000/v1
LITELLM_PROXY_PORT=4000
LITELLM_MASTER_KEY=sk-local
LITELLM_LOCAL_MODEL_COST_MAP=True

# ------------------------------------------------------------
# Machine 2 public API exposure
# ------------------------------------------------------------
# API Gateway runs locally on port 8001. The startup script reads the
# temporary public URL directly from ngrok and prints it in the terminal.
MACHINE2_API_HOST=0.0.0.0
MACHINE2_API_PORT=8001
MACHINE2_API_LOCAL_URL=http://localhost:8001
# Optional: only set this when your ngrok account has a reserved/static domain.
# Leave it empty on ngrok Free so scripts/run_ngrok.sh can create a random URL.
NGROK_RESERVED_DOMAIN=

# LiteLLM stays internal. Machine 3 uses the API Gateway above.
MACHINE2_LITELLM_LOCAL_URL=http://localhost:4000

# ------------------------------------------------------------
# Qdrant vector database
# ------------------------------------------------------------
# docker-compose.yml exposes Qdrant on localhost:6333.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Shared MKAC knowledge base
MKAC_COLLECTION_NAME=mkac_knowledge
MKAC_SOURCE_DIR=documents/MKAC
MKAC_MANIFEST_PATH=config/mkac_manifest.json
MKAC_PAGE_IMAGE_DIR=mkac_processed/pages
MKAC_INDEX_REPORT=logs/mkac_index_report.json
MKAC_SCORE_THRESHOLD=0.48
# Search the public web only when no internal MKAC chunk passes the threshold.
MKAC_WEB_SEARCH_ENABLED=true
MKAC_WEB_SEARCH_CONTEXT="Công ty Cổ phần Meiko Automation MKAC"
MKAC_WEB_SEARCH_REGION=vn-vi
MKAC_WEB_SEARCH_MAX_RESULTS=5
MKAC_WEB_SEARCH_TIMEOUT=10

# ------------------------------------------------------------
# API Gateway / runtime paths
# ------------------------------------------------------------
# Used by src/api/main.py for uploaded documents and logging.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
QUERY_RATE_LIMIT_PER_MINUTE=15
UPLOAD_RATE_LIMIT_PER_HOUR=10
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Agent / MCP workspace
# ------------------------------------------------------------
# Required when calling POST /agent via the public API.
AGENT_API_KEY=replace_with_a_long_random_secret

# Directory that MCP filesystem/git tools are allowed to access.
WORKSPACE_DIR=/home/jkl0909/Code/llm
AGENT_REPOSITORY_DIR=/home/jkl0909/Code/llm/VLLM-PD
