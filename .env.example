# ============================================================
# VLLM-PD local configuration template
# Copy this file to `.env`, then replace placeholder values.
# Do not commit `.env` because it may contain real API keys.
# ============================================================

# ------------------------------------------------------------
# Machine 1 / LLM host
# ------------------------------------------------------------
# Optional Tailscale IP or hostname of Machine 1.
# Current setup uses Machine 1's ngrok URL below instead.
TAILSCALE_M1_IP=your_machine_1_tailscale_ip_here

# Machine 1 currently exposes Ollama/Gemma4 through ngrok:
# https://carless-overarch-establish.ngrok-free.dev -> http://localhost:11434
OLLAMA_API_BASE=https://carless-overarch-establish.ngrok-free.dev
OLLAMA_MODEL=gemma4:latest

# ------------------------------------------------------------
# Cloud fallback API keys
# ------------------------------------------------------------
# Used by litellm_config.yaml for fallback routes.
# Leave placeholders if you only want to test local Ollama models.
OPENAI_API_KEY=your_openai_api_key_here
MIMO_API_KEY=your_mimo_api_key_here

# ------------------------------------------------------------
# LiteLLM proxy
# ------------------------------------------------------------
# Python code expects the OpenAI-compatible /v1 base URL.
# Docker compose exposes LiteLLM on localhost:4000.
LITELLM_URL=http://localhost:4000/v1
LITELLM_PROXY_PORT=4000
LITELLM_MASTER_KEY=sk-local
LITELLM_LOCAL_MODEL_COST_MAP=True

# ------------------------------------------------------------
# Machine 2 public API exposure
# ------------------------------------------------------------
# API Gateway runs locally on port 8001. When you expose Machine 2
# via ngrok, put the public URL here so Machine 3 clients can use it.
MACHINE2_API_HOST=0.0.0.0
MACHINE2_API_PORT=8001
MACHINE2_API_LOCAL_URL=http://localhost:8001
MACHINE2_API_PUBLIC_URL=https://replace-with-machine-2-ngrok-url.ngrok-free.app

# Optional: if you expose LiteLLM itself through ngrok for direct
# OpenAI-compatible access from Machine 3, put that URL here.
MACHINE2_LITELLM_LOCAL_URL=http://localhost:4000
MACHINE2_LITELLM_PUBLIC_URL=https://replace-with-machine-2-litellm-ngrok-url.ngrok-free.app

# ------------------------------------------------------------
# Qdrant vector database
# ------------------------------------------------------------
# docker-compose.yml exposes Qdrant on localhost:6333.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ------------------------------------------------------------
# API Gateway / runtime paths
# ------------------------------------------------------------
# Used by src/api/main.py for uploaded documents and logging.
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Agent / MCP workspace
# ------------------------------------------------------------
# Directory that MCP filesystem/git tools are allowed to access.
WORKSPACE_DIR=/home/jkl0909/Code/llm
